<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>PetDock.SamplePet</RootNamespace>
    <AssemblyName>PetDock.SamplePet</AssemblyName>
    <Product>PetDock</Product>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 依赖方向（docs/40 §2）：plugins → core，绝不反向 -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\core\PetDock.Core\PetDock.Core.csproj" />
  </ItemGroup>

</Project>
