<UserControl x:Class="PetDock.Ui.Default.PetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="34,24,34,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button x:Name="ImportButton" DockPanel.Dock="Right"
                    Style="{DynamicResource Pd.PrimaryButton}"
                    Click="OnImportClick" />
            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Style="{DynamicResource Pd.DangerButton}"
                    Click="OnDeleteClick" IsEnabled="False" />
            <Button x:Name="DuplicateButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Style="{DynamicResource Pd.SecondaryButton}"
                    Click="OnDuplicateClick" IsEnabled="False" />
            <TextBlock x:Name="CountText" Style="{DynamicResource Pd.Dim}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Style="{DynamicResource Pd.Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,14,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ColName" Style="{DynamicResource Pd.Muted}" />
                    <TextBlock Grid.Column="1" x:Name="ColSource" Style="{DynamicResource Pd.Muted}" />
                    <TextBlock Grid.Column="2" x:Name="ColState" Style="{DynamicResource Pd.Muted}" />
                    <TextBlock Grid.Column="3" x:Name="ColMemory" Style="{DynamicResource Pd.Muted}" />
                </Grid>

                <ListBox Grid.Row="1" x:Name="Rows" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="10" Padding="10,10" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource Pd.Body}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{DynamicResource Pd.Dim}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding State}" Style="{DynamicResource Pd.Dim}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Memory}" Style="{DynamicResource Pd.Dim}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" x:Name="EmptyPanel" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="24">
                    <TextBlock x:Name="EmptyTitle" Style="{DynamicResource Pd.Body}"
                               HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               TextAlignment="Center" MaxWidth="460" />
                    <TextBlock x:Name="EmptyNote" Style="{DynamicResource Pd.Dim}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="440"
                               TextAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="2" x:Name="DetailBar" Visibility="Collapsed" Margin="18,8,18,4"
                        Background="{DynamicResource Pd.SurfaceHover}" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DetailIconFrame" Width="54" Height="54" CornerRadius="8"
                                Background="{DynamicResource Pd.AccentSoft}" Visibility="Collapsed">
                            <Image x:Name="DetailIcon" Stretch="Uniform" Margin="4" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="DetailAuthor" Style="{DynamicResource Pd.Body}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailLicense" Style="{DynamicResource Pd.Dim}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailPath" Style="{DynamicResource Pd.Muted}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" x:Name="ErrorBar" Visibility="Collapsed" Margin="14,8,14,14"
                        Background="{DynamicResource Pd.BadSurface}" CornerRadius="9" Padding="12,9">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Pd.Bad}"
                               FontSize="12.5" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
