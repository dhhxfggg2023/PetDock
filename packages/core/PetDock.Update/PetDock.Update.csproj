<Project Sdk="Microsoft.NET.Sdk">

  <!--
    搬运工（2026-10-31）：把下载好的新版本换到正在运行的那份程序上。

    为什么必须是一个独立进程：要覆盖的文件（PetDock.Core.exe / .dll）正被宿主加载着，
    Windows 不允许自我替换。宿主先退出，再由这个进程搬，搬完把程序开回来。

    它不是「内核的一部分」：
      · 不引用 PetDock.Core，也不引用任何插件 —— 搬一个坏掉的内核正是它要能处理的情形；
      · 判据（D-03a 行数预算、D-03b 概念黑名单）只扫 packages/core/PetDock.Core，
        本工程不在那些口径里，所以它自己的行数由自己的测试守住（见 UpdateHelper/）。
      · 它有自己的一份极小的日志，写在暂存目录，跟着更新一起被清掉。

    发布形态：与宿主同目录（发布物根下一份 PetDock.Update.exe）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>PetDock.Update</RootNamespace>
    <AssemblyName>PetDock.Update</AssemblyName>
    <Product>PetDock</Product>

    <!-- 版本号唯一事实源是 package.json；这里镜像它，tools/version-parity.mjs 卡住漂移。 -->
    <Version>0.4.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
