<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>

    <RootNamespace>PetDock.Core</RootNamespace>
    <AssemblyName>PetDock.Core</AssemblyName>
    <Product>PetDock</Product>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WPF 的数据绑定在 XmlLanguage.GetSpecificCulture() 里要真文化；InvariantGlobalization
         会让 'en-us' 解析成不变文化而抛 XamlParseException（2026-10-28 插件页首次渲染实测）。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 应用图标（2026-10-26）：仓库自绘的像素猫，assets/icons/icon.ico 是多分辨率 ICO。
         在此之前 exe 里没有图标资源，资源管理器里显示的是 .NET 默认图。 -->
    <ApplicationIcon>..\..\..\assets\icons\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- RFC-06 §4 的自检面外迁（2026-10-18）：12 个自检/判据源文件已从 src/SelfTest/ 与 src/Host/
       移到本工程的 test/SelfCheck/，编译产物仍是同一个 PetDock.Core.exe（六个命令行入口的命令形态
       不变；SDK 的默认 glob 已包含 test/ 下的 .cs，此处不再重复 Compile Include）。
       D-03a 的 core-loc 不计入 test/ 目录，故这一搬动正是还款义务要求的 LOC 下降；
       这些文件是判据体、不是内核能力，留在此处只为让它们继续跑在 core 的入口进程里（RFC-01 §2.3）。 -->

  <!-- M1 契约 §4（交接档案）：Tier-1 沙箱基座 = WASM + WASI Preview2，     -->
  <!-- 绑定库 = Wasmtime for .NET 34.0.2（Bytecode Alliance 官方维护）。原规格 14 §4 白名单首项。 -->
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="34.0.2" />
  </ItemGroup>

</Project>