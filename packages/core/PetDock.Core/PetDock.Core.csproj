<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>PetDock.Core</RootNamespace>
    <AssemblyName>PetDock.Core</AssemblyName>
    <Product>PetDock</Product>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- M1 契约 §4（.dsh-code/M1-contract-frozen.md）：Tier-1 沙箱基座 = WASM + WASI Preview2，     -->
  <!-- 绑定库 = Wasmtime for .NET 34.0.2（Bytecode Alliance 官方维护）。docs/14 §4 白名单首项。 -->
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="34.0.2" />
  </ItemGroup>

</Project>
