<UserControl x:Class="PetDock.Core.Ui.UiWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Pd.Bg}"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="{DynamicResource Pd.Text}">
    <UserControl.Resources>
        <!-- 主题刷子由 UiWorkspaceView.ApplyPalette 在构造时注入；样式只引用键名。
             这样页面插件不依赖内核的 Theme 类型，也不需要知道现在是亮还是暗。 -->
        <!-- 键盘焦点框：自绘模板的按钮/开关默认没有可见焦点，键盘用户会「按了没反应」。
             用虚线描边而不是系统默认（系统默认在深色底上几乎看不见）。 -->
        <Style x:Key="Pd.FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="1" StrokeThickness="2" Stroke="{DynamicResource Pd.Accent}"
                                   StrokeDashArray="2 2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pd.PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Pd.PageNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Pd.Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="Pd.Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Pd.Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Pd.Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Pd.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Pd.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pd.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="Pd.Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Pd.SurfaceHover}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,3" />
        </Style>
        <Style x:Key="Pd.PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Pd.OnAccent}" />
            <Setter Property="Background" Value="{DynamicResource Pd.Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pd.SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
            <Setter Property="Background" Value="{DynamicResource Pd.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pd.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pd.GhostButton" TargetType="Button" BasedOn="{StaticResource Pd.SecondaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.TextDim}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="Pd.DangerButton" TargetType="Button" BasedOn="{StaticResource Pd.SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Pd.Bad}" />
        </Style>
        <Style x:Key="Pd.NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Pd.TextDim}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="12,9">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.AccentSoft}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Pd.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pd.Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Pd.Line}" />
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource Pd.Surface}"
                                    HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Pd.Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Pd.OnAccent}" />
                            </Trigger>
                            <!-- 随包界面插件不能停用：灰掉开关，避免看起来能点却无效。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pd.Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Pd.TextDim}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Pd.Line}"
                                BorderThickness="1" CornerRadius="9" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pd.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Pd.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 连续尺寸滑块（2026-10-29）：自绘轨道/拇指，颜色只认主题令牌；
             默认 WPF 模板用的是系统色，在深色底上看不见。 -->
        <Style x:Key="Pd.Slider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource Pd.Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Pd.Accent}"
                                                         Stroke="{DynamicResource Pd.Surface}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource Pd.Line}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pd.TextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Pd.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pd.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource Pd.Accent}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左导航：品牌 + 插件贡献的页 + 底部版本位 -->
        <Border Grid.Column="0" Background="{DynamicResource Pd.BgDeep}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Pd.Accent}">
                            <TextBlock Text="P" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource Pd.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PetDock" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Pd.Text}" />
                            <TextBlock x:Name="BrandSub" Text="desktop pets" FontSize="10.5"
                                       Foreground="{DynamicResource Pd.TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Margin="22,0,18,18"
                           FontSize="10.5" Foreground="{DynamicResource Pd.TextMuted}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavHost" Margin="0,2,0,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右内容：页头 + 页面 + 状态条。页头不画刷新按钮：页面自己按数据变化重绑。 -->
        <Grid Grid.Column="1" Background="{DynamicResource Pd.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="34,26,34,18" BorderBrush="{DynamicResource Pd.Line}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource Pd.PageTitle}" />
                    <TextBlock x:Name="NoteText" Style="{StaticResource Pd.PageNote}" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" x:Name="PageHost" Margin="0" />

            <Border Grid.Row="2" Padding="34,10" BorderBrush="{DynamicResource Pd.Line}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Pd.Dim}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- 长任务的进度条与取消：只在宿主跑导入/安装时出现（UiHost.Work.cs）。 -->
                    <ProgressBar x:Name="WorkBar" Grid.Column="1" Width="150" Height="6" Margin="12,0"
                                 IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Pd.Accent}"
                                 Background="{DynamicResource Pd.Line}" BorderThickness="0" />
                    <Button x:Name="WorkCancel" Grid.Column="2" Visibility="Collapsed"
                            Style="{StaticResource Pd.GhostButton}" Click="OnCancelWork" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
