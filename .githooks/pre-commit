#!/bin/sh
# 每次提交前刷新开发账本的跨卷副本。
#
# 为什么：开发账本（决策/教训/任务板/交接件）活在 .dsh-code/，被 .gitignore 忽略。
# 它只在本机，**且刻意不进仓库**：`dhhxfggg2023/PetDock` 是私有库、以后要转公开，
# 账本里有本机绝对路径、账号名、出口 IP 等只该留在本地的东西（2026-10-16 决定：
# 账本出库 + 历史里 purge 掉 ledger/，见 decisions.md）。所以这里只做跨卷副本，
# 不再 git add ledger/，ledger/ 也已写进 .gitignore。
#
# 本钩子**永不阻塞提交**：快照是保险，不该变成新的失败面。任何一步出错都打印一行说明并退出 0。
# 安装：git config core.hooksPath .githooks（已设置；换机器后重跑一次即可）

out=$(node tools/ledger-export.mjs --backup 2>&1)
rc=$?
if [ $rc -eq 0 ]; then
  echo "[ledger] 跨卷副本已刷新（不入库）"
else
  echo "[ledger] 快照失败（exit $rc），提交继续；手动排查：node tools/ledger-export.mjs --backup"
  echo "$out" | tail -3
fi
exit 0
