<Project Sdk="Microsoft.NET.Sdk">

  <!-- M7 验收（docs/33 §7）：BongoCat 交互重写的判据面。
       为什么在 tests/ 而不是 packages/core/test：判据必须按片段名断言（idle / look_left / paw_r …），
       而片段名是插件知识 —— docs/01 P-02 第 4 条禁止 core 源码写任何插件名。
       放在这里，core 保持不认识 BongoCat，判据仍能逐条可判。
       本工程不在 packages/ 下，因此 depscan 的 D-02 层规则不管它；它同时引用 core 与插件是正当的。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RootNamespace>PetDock.BongoCat.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\core\PetDock.Core\PetDock.Core.csproj" />
    <ProjectReference Include="..\..\..\packages\plugins\petdock.bongocat\PetDock.BongoCat\PetDock.BongoCat.csproj" />
  </ItemGroup>

</Project>
