<Project Sdk="Microsoft.NET.Sdk">

  <!-- t4（docs/41 D-11a/D-11b）：ABI 契约基线测试工程。夹具本体在 ../abi-contract/，      -->
  <!-- 本工程把基线对着 PetDock.Core.dll **反射逐条核验**——判据读代码，不读注释           -->
  <!-- （M1 PetColor 教训：对照表声称存在、代码里没有）。                                  -->
  <!-- 诚实性纪律：每个正向断言都配一条「把基线改坏 → 核验器必须报错」的负向自证            -->
  <!-- （M1 t5 教训：空操作夹具被当成 PASS，安全网从没被触发过）。                          -->
  <!-- sln 唯一写者是 t4：本工程由 dotnet sln add 挂入（见 csproj 不进手工文本）。          -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <IsPackable>false</IsPackable>
    <RootNamespace>PetDock.AbiContract.Tests</RootNamespace>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 本机证据通道（账本 pit 2026-10-16 testhost Win32 5）：DSH 沙箱下 dotnet test/vstest 的
         testhost 无法 OpenProcess 父进程，必然中止；CI 无沙箱走正常的 dotnet test。本工程自带
         反射入口（Runner.cs 的 Main）：`dotnet <dll路径>` 无参 = 跑全部 [Fact] 并打印 PASS/FAIL 行、
         失败数=退出码 —— 与 dotnet test 执行**同一批**方法、同一套 Assert 语义。 -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- D-10a 覆盖测定：README.md 的命令用 coverlet 把阈值变成退出码。 -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只引用 core（t1 契约 §7.1 第 2 条：tests/ 不享受 D-02c 豁免，core 测试只引用 core 与 sdk）。 -->
    <ProjectReference Include="..\..\..\packages\core\PetDock.Core\PetDock.Core.csproj" />
  </ItemGroup>

  <!-- 夹具随测试复制到输出目录；测试从 AppContext.BaseDirectory/abi-contract 读，源树只读。 -->
  <ItemGroup>
    <Content Include="..\abi-contract\**\*.json" LinkBase="abi-contract" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\abi-contract\**\*.js" LinkBase="abi-contract" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
