// docs/41 D-11a 的「最小旧版调用序列」夹具：**声明**这份基线插件依赖的 ABI 能力/成员集合。
//
// 它为什么存在（裁定依据）：D-11a 逐字要求「仓库维护一份『最小旧版插件清单 + 最小旧版调用序列』
// 基线夹具，声明它所依赖的 ABI 能力句柄集合。每次宿主改动后，CI 用基线夹具做一次『旧插件加载』
// 模拟，任一基线能力缺失或签名变更即失败」。
//
// 它与 `petdock-plugin.json` 的分工：
//   - manifest（同级目录）= 「最小旧版插件清单」：一份**旧 api.major/minor** 的合法 manifest，
//     证明旧清单今天仍能被 docs/21 校验通过、仍能被发现与装载。
//   - 本文件 = 「最小旧版调用序列」：字节级列出基线所依赖的**类型名与成员名**。
//     由 core 测试用反射对着 `PetDock.Core.dll` 逐条核（见 PetDock.Core.Tests 的
//     AbiBaselineTests），**绝不 grep 注释** —— 这是 M2 t2 里 `PetColor` 那次
//     「名字对照表声称存在、代码里没有」的直接教训：判据读代码，不读注释。
//
// 为什么用 .json 而不是 .cs：它是**夹具数据**，不是被测代码；放 tests/fixtures/ 下与 manifest 同形，
// 让 t5/t6 能用任何语言读它、也能直接被 tools/ 下的脚本消费。它不进任何 csproj 的编译。
//
// 维护规则（写给下一次改 ABI 的人）：
//   只许**增加**条目。删除或改名任何一条 = 旧插件会编译不过/装载失败 = D-11b 的「移除或收窄」，
//   必须走 docs/43 RFC 并标注废弃窗口（docs/41:71-72）。新增条目同时要更新本文件与
//   tests/PetDock.Core.Tests/AbiBaselineTests.cs 的期望表。
{
  "//": "M2 ABI baseline call sequence — docs/41 D-11a. Append-only.",
  "interface": "petdock.runtime",
  "api": { "major": 1, "minor": 0 },

  "//types": "基线依赖的核心类型（docs/11 §2-§6 的词汇表）。name 必须能在 PetDock.Core.dll 里解析到。",
  "types": [
    "PetDock.Core.PetRuntime.Frame",
    "PetDock.Core.PetRuntime.AnimationClip",
    "PetDock.Core.PetRuntime.PetEvent",
    "PetDock.Core.PetRuntime.PetPoint",
    "PetDock.Core.PetRuntime.PetRect",
    "PetDock.Core.PetRuntime.PetSize",
    "PetDock.Core.PetRuntime.PetColor",
    "PetDock.Core.PetRuntime.InterfaceMeta",
    "PetDock.Core.PetRuntime.PetDescription",
    "PetDock.Core.PetRuntime.WorldSnapshot",
    "PetDock.Core.PetRuntime.BrainDirective",
    "PetDock.Core.PetRuntime.BrainContext",
    "PetDock.Core.PetRuntime.PetViewContext",
    "PetDock.Core.PetRuntime.RenderTarget",
    "PetDock.Core.PetRuntime.BitmapRegistry",
    "PetDock.Core.PetRuntime.BitmapHandle",
    "PetDock.Core.PetRuntime.ResourceBudget",
    "PetDock.Core.PetRuntime.ClipLoop",
    "PetDock.Core.PetRuntime.ClipAnchor",
    "PetDock.Core.PetRuntime.PointerButton",
    "PetDock.Core.PetRuntime.InstanceState",
    "PetDock.Core.PetRuntime.DisplayTier",
    "PetDock.Core.PetRuntime.DegradationChain",
    "PetDock.Core.PetRuntime.DirectiveKind"
  ],

  "//interfaces": "基线实现的四个 ABI 接口。members 逐条列出 docs/11 §3-§6 声明的成员名。",
  "interfaces": [
    {
      "name": "PetDock.Core.PetRuntime.IPetView",
      "doc": "docs/11 §3",
      "members": [
        "Meta", "InitAsync", "Describe", "Attach", "Detach", "DisposeAsync",
        "SetAnimation", "QueryFrame", "OnEvent"
      ]
    },
    {
      "name": "PetDock.Core.PetRuntime.IBrain",
      "doc": "docs/11 §4",
      "members": ["Meta", "InitAsync", "DisposeAsync", "Tick", "OnEvent"]
    },
    {
      "name": "PetDock.Core.PetRuntime.IPointerSurface",
      "doc": "docs/11 §5",
      "members": ["Id", "Priority", "HitTest", "OnPointerDown"]
    },
    {
      "name": "PetDock.Core.PetRuntime.IPointerSession",
      "doc": "docs/11 §5",
      "members": ["OnPointerMove", "OnPointerUp", "OnCancel", "Cursor"]
    },
    {
      "name": "PetDock.Core.PetRuntime.IPetState",
      "doc": "docs/11 §6",
      "members": ["SchemaVersion", "ReadAll", "Read", "Write", "CommitAsync", "Rollback", "Migrate"]
    },
    {
      "name": "PetDock.Core.PetRuntime.IClipCatalog",
      "doc": "docs/11 §2.3（兼容增量：可选实现）",
      "members": ["Clips"]
    }
  ],

  "//enums": "枚举的合法取值集合：收窄取值同样算 D-11b 的『收窄』，故逐值列出。",
  "enums": [
    { "name": "PetDock.Core.PetRuntime.ClipLoop", "values": ["Once", "Loop", "PingPong"] },
    { "name": "PetDock.Core.PetRuntime.PointerButton", "values": ["Left", "Right", "Middle"] },
    {
      "name": "PetDock.Core.PetRuntime.InstanceState",
      "values": ["Discovered", "Imported", "Instantiated", "Running", "Suspended", "Disposed"]
    },
    {
      "name": "PetDock.Core.PetRuntime.DisplayTier",
      "values": ["Real", "ReducedRate", "Placeholder", "Hidden"]
    },
    {
      "name": "PetDock.Core.PetRuntime.DirectiveKind",
      "values": ["RequestCapability", "Emit", "MoveTo", "SetAnimation", "Resume", "Suspend"]
    }
  ],

  "//directive-arbitration": "docs/11:162 的仲裁顺序（ABI 语义）。基线把它冻结为『Suspend 最先』。",
  "directiveOrderDescending": [
    "Suspend", "Resume", "SetAnimation", "MoveTo", "Emit", "RequestCapability"
  ],

  "//capabilities": "基线声明依赖的能力 id（docs/14 §2 白名单）。空 = 基线插件不请求任何能力。",
  "capabilities": []
}
